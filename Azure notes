pool:
  vmImage: ubuntu-latest

variables:
  dockerRegistryServiceConnection: 'dockerhub-service-connection'
  imageRepository: 'rahamshaik007/jenkins-java-project'
  dockerfilePath: '**/Dockerfile'
  tag: '$(Build.BuildId)'

stages:

# ===================================================
# BUILD STAGE
# ===================================================
- stage: Build
  displayName: Build Java App

  jobs:
  - job: MavenBuild

    steps:

    - checkout: self

    - task: Maven@4
      displayName: Maven Build
      inputs:
        mavenPomFile: 'pom.xml'
        goals: 'clean package'
        publishJUnitResults: true
        testResultsFiles: '**/surefire-reports/TEST-*.xml'

# ===================================================
# DOCKER STAGE
# ===================================================
- stage: Docker
  displayName: Docker Build Push

  dependsOn: Build

  jobs:
  - job: DockerPush

    steps:

    - checkout: self

    # LOGIN
    - task: Docker@2
      displayName: Docker Login
      inputs:
        command: login
        containerRegistry: 'dockerhub-service-connection'

    # BUILD IMAGE
    - task: Docker@2
      displayName: Build Docker Image
      inputs:
        command: build
        repository: '$(imageRepository)'
        dockerfile: '$(dockerfilePath)'
        tags: |
          latest
          $(tag)

    # PUSH IMAGE
    - task: Docker@2
      displayName: Push Docker Image
      inputs:
        command: push
        repository: '$(imageRepository)'
        containerRegistry: 'dockerhub-service-connection'
        tags: |
          latest
          $(tag)

