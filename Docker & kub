                }
            }
        }
        stage("Scan the Image") {
            steps {
                sh 'trivy image rahamshaik/mydockerprojectfor5pm:myzomatoimage'
            }
        }
        stage("Container") {
            steps {
                sh 'docker run -d --name cont1 -p 3000:3000 rahamshaik/mydockerprojectfor5pm:myzomatoimage'
            }
        }
    }
}





