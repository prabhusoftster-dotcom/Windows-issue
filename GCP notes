Pre script:


#!/bin/bash

LOG_FILE="/var/log/prepatch.log"
THRESHOLD_CPU=80
THRESHOLD_DISK=80

echo "===== PRE-PATCH CHECK START $(date) =====" | tee -a $LOG_FILE

# 1. Check CPU Load
CPU_LOAD=$(top -bn1 | grep "load average" | awk '{print $10}' | cut -d',' -f1)
echo "CPU Load: $CPU_LOAD" | tee -a $LOG_FILE

# 2. Check Disk Usage
DISK_USAGE=$(df / | tail -1 | awk '{print $5}' | sed 's/%//')
echo "Disk Usage: $DISK_USAGE%" | tee -a $LOG_FILE

if [ "$DISK_USAGE" -gt "$THRESHOLD_DISK" ]; then
echo "ERROR: Disk usage too high. Aborting patch." | tee -a $LOG_FILE
exit 1
fi

# 3. Check Memory
FREE_MEM=$(free -m | awk '/Mem:/ {print $4}')
echo "Free Memory: ${FREE_MEM}MB" | tee -a $LOG_FILE

if [ "$FREE_MEM" -lt 200 ]; then
echo "ERROR: Not enough memory. Aborting patch." | tee -a $LOG_FILE
exit 1
fi

# 4. Check Critical Services
SERVICES=("nginx" "ssh")

for SERVICE in "${SERVICES[@]}"; do
systemctl is-active --quiet $SERVICE
if [ $? -ne 0 ]; then
echo "ERROR: $SERVICE is not running. Aborting patch." | tee -a $LOG_FILE
exit 1
fi
done

# 5. Optional: Create Snapshot Marker (for rollback tracking)
echo "Creating pre-patch marker..."
touch /tmp/prepatch_$(date +%F)

echo "===== PRE-PATCH CHECK PASSED =====" | tee -a $LOG_FILE
exit 0


Post script:

#!/bin/bash

LOG_FILE="/var/log/postpatch.log"

echo "===== POST-PATCH VALIDATION START $(date) =====" | tee -a $LOG_FILE

# 1. Check System Uptime
UPTIME=$(uptime -p)
echo "System Uptime: $UPTIME" | tee -a $LOG_FILE

# 2. Verify Services
SERVICES=("nginx" "ssh")

for SERVICE in "${SERVICES[@]}"; do
systemctl is-active --quiet $SERVICE
if [ $? -ne 0 ]; then
echo "ERROR: $SERVICE is not running after patch!" | tee -a $LOG_FILE
exit 1
fi
done

# 3. Check Open Ports
PORTS=(80 22)

for PORT in "${PORTS[@]}"; do
nc -z localhost $PORT
if [ $? -ne 0 ]; then
echo "ERROR: Port $PORT not responding!" | tee -a $LOG_FILE
exit 1
fi
done

# 4. Check Application Health Endpoint
HEALTH_URL="http://localhost/health&quot;

HTTP_STATUS=$(curl -s -o /dev/null -w "%{http_code}" $HEALTH_URL)

if [ "$HTTP_STATUS" != "200" ]; then
echo "ERROR: Health check failed with status $HTTP_STATUS" | tee -a $LOG_FILE
exit 1
fi

# 5. Scan Logs for Errors
ERROR_COUNT=$(grep -i "error" /var/log/syslog | wc -l)

echo "Error count in logs: $ERROR_COUNT" | tee -a $LOG_FILE

echo "===== POST-PATCH VALIDATION SUCCESS =====" | tee -a $LOG_FILE
exit 0




